const char* generatedMoveDescription(uint16_t moveId) {
  static char output[160];
  if (moveId >= sizeof(kMoveDescriptionOffsets) / sizeof(kMoveDescriptionOffsets[0]) ||
      kMoveDescriptionOffsets[moveId] == 0xFFFFU)
    return "NO DESCRIPTION AVAILABLE.";
  uint16_t cursor = kMoveDescriptionOffsets[moveId];
  uint16_t written = 0;
  bool first = true;
  while (kMoveDescriptionData[cursor] != 0xFFU && written + 1U < sizeof(output)) {
    if (!first && written + 1U < sizeof(output)) output[written++] = ' ';
    first = false;
    const uint8_t token = kMoveDescriptionData[cursor++];
    if (token) {
      uint16_t offset = kMoveDescriptionWordOffsets[token - 1U];
      const uint16_t end = kMoveDescriptionWordOffsets[token];
      while (offset < end && written + 1U < sizeof(output))
        output[written++] = static_cast<char>(kMoveDescriptionWords[offset++]);
    } else {
      uint8_t length = kMoveDescriptionData[cursor++];
      while (length-- && written + 1U < sizeof(output))
        output[written++] = static_cast<char>(kMoveDescriptionData[cursor++]);
    }
  }
  output[written] = '\0';
  return output;
}
