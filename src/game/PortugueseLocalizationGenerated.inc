  {0x735936BDU, "EXPLODES ON FOES, BUT RESTORES ALLY'S HP.", "EXPLODE EM INIMIGOS, MAS RESTAURA O HP DO ALIADO."},
  {0x735B8AF2U, "THE FOE IS COVERED WITH A MASS OF DOWN THAT SHARPLY CUTS THE ATTACK STAT.", "O INIMIGO ESTA COBERTO COM UMA MASSA DE BAIXO QUE CORTA DRASTICAMENTE O ESTADO DE ATAQUE."},
  {0x735BB231U, "THE FOE IS ATTACKED WITH SMALL FLAMES. THE FOE MAY SUFFER A BURN.", "O INIMIGO E ATACADO COM PEQUENAS CHAMAS, O INIMIGO PODE SOFRER UMA QUEIMADURA."},
  {0x7364E295U, "It lures Pokemon in with its pattern that looks just like a Poke Ball, then releases its poison spores. Why it resembles a Poke Ball is unknown.", "ELE ATRAI POKEMON COM SEU PADRAO QUE SE PARECE COM UMA BOLA DE POKE, ENTAO LIBERA SEUS ESPOROS VENENOSOS."},
