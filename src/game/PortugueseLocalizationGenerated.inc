  {0xFE886367U, "A spicy aroma emanates from around its neck. The aroma acts as a stimulant to restore health.", "UM AROMA PICANTE EMANA DE SEU PESCOCO, O AROMA AGE COMO UM ESTIMULANTE PARA RESTAURAR A SAUDE."},
  {0xFE90C40AU, "HOME BACKGROUND", "FUNDO DE CASA"},
  {0xFE97CAD4U, "It has the power to predict the future. Its power peaks when it is protecting its TRAINER.", "ELE TEM O PODER DE PREVER O FUTURO, SEU PODER ATINGE O PICO QUANDO ESTA PROTEGENDO SEU TREM."},
  {0xFEB689CCU, "A SLEEPING FOE IS SHOWN A NIGHTMARE THAT INFLICTS SOME DAMAGE EVERY TURN.", "UM INIMIGO ADORMECIDO E MOSTRADO UM PESADELO QUE INFLIGE ALGUM DANO A CADA TURNO."},
