  {0x714C9BCAU, "COLOR THEMES", "TEMAS DE CORES"},
  {0x7150ED08U, "When it battles, within its beak, its internal gases ignite, explosively launching seeds with enough power to pulverize boulders.", "QUANDO ELE LUTA, DENTRO DE SEU BICO, SEUS GASES INTERNOS INFLAMAM, LANCANDO EXPLOSIVAMENTE SEMENTES COM PODER SUFICIENTE PARA PULVERIZAR PEDREGULHOS."},
  {0x7160AFD5U, "PAIN", "DOR"},
  {0x7162E86CU, "YOU NEED OUR HELP!", "VOCE PRECISA DA NOSSA AJUDA!"},
  {0x7164C718U, "They battle with hard berries for weapons. They form groups of about 20 individuals. Their techniques are passed from the boss to the group, generation upon generation.", "ELES LUTAM COM BAGAS DURAS POR ARMAS, FORMAM GRUPOS DE CERCA DE 20 INDIVIDUOS, SUAS TECNICAS SAO PASSADAS DO CHEFE PARA O GRUPO, GERACAO APOS GERACAO."},
  {0x716A23F9U, "A LEGENDARY PRESENCE APPEARED!", "UMA PRESENCA LENDARIA APARECEU!"},
  {0x716EE544U, "RAISES THE HOLDER'S CRITICAL-HIT CHANCE.", "AUMENTA A CHANCE DO TITULAR SER ATINGIDO PELA CRITICA."},
  {0x7172D865U, "SAVE EXPORT IS ALREADY COMPLETE.", "A EXPORTACAO DE DADOS DO JOGO JA ESTA COMPLETA."},
  {0x7188B6D3U, "EXACTLY", "EXATAMENTE."},
  {0x718C8EE1U, "It is found in volcanic craters. Its body heat exceeds 1,100 degrees Fahrenheit, so don't underestimate it.", "ELE E ENCONTRADO EM CRATERAS VULCANICAS, SEU CALOR CORPORAL EXCEDE 1.100 GRAUS FAHRENHEIT, ENTAO NAO O SUBESTIME."},
  {0x718E7770U, "MARLON", "MARLON."},
  {0x718F664DU, "THE USER ATTACKS WITH A BLADE OF AIR THAT SLICES EVEN THE SKY. IT MAY ALSO MAKE THE TARGET FLINCH.", "O USUARIO ATACA COM UMA LAMINA DE AR QUE CORTA ATE MESMO O CEU."},
  {0x719123E0U, "THE USER PREVENTS THE FOE FROM USING ANY HP-RECOVERY MOVES FOR FIVE TURNS.", "O USUARIO IMPEDE O INIMIGO DE USAR QUALQUER MOVIMENTO DE RECUPERACAO DE HP POR CINCO TURNOS."},
